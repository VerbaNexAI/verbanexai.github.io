  bibtex_show  = {true},
  author       = {Jhonattan Llamas and Jairo E. Serrano and Juan Carlos Martinez-Santos},
  title        = {COTECMAR–UTB at TalentCLEF 2025: Linking Job Titles and ESCO Skills with Sentence Transformer Embeddings},
