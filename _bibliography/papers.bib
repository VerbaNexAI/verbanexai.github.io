@inproceedings{Amaya2025ImageRetrieval,
  abbr         = {CLEF},
  bibtex_show  = {true},
  author       = {Diego Alberto Guevara Amaya and Jairo E. Serrano and Juan Carlos Martinez-Santos},
  title        = {CEDNAV–UTB: Efficient Image Retrieval for Arguments with CLIP},
